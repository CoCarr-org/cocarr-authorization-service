# cocarr-authorization-service — environment
NODE_ENV=production
PORT=3060

# --- IAM database (MySQL) ----------------------------------------------------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=cocarr_iam
DB_USER=cocarr
DB_PASS=change-me

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=https://admin.cocarr.com

# --- Firebase (JWT verification for mutating endpoints) ----------------------
ADMIN_SERVICE_ACCOUNT=
AUTH_DISABLED=false
